# ---- Sitio ----
# Dominio público canónico. Se usa para las URLs de retorno de Stripe
# (success/cancel/portal). Ponlo en Vercel para no depender de cabeceras: sin él,
# en serverless request.url puede resolver a http://localhost y Stripe devolvería
# al visitante a "localhost".
# SIEMPRE con `www`: en Vercel el ápice pelado responde 308 hacia www, y hay
# terceros que no siguen redirects (fue la causa del incidente del webhook).
PUBLIC_SITE_URL=https://www.emilseriosacademy.com

# ---- Google Search Console (opcional) ----
# Token de verificación de propiedad del sitio. SOLO el valor del `content`, no
# la etiqueta entera: Google te da
#   <meta name="google-site-verification" content="AbC123..." />
# y aquí va únicamente `AbC123...`. Con esto, la carta de ventas pinta el meta y
# Google puede confirmar que el sitio es de Emi. Si verificas por DNS TXT (lo
# recomendado, ver docs/GOOGLE.md), esta variable no hace falta.
GOOGLE_SITE_VERIFICATION=

# ---- Google Analytics 4 (opcional) ----
# ID de medición de GA4, con el formato G-XXXXXXXXXX. Lo sacas de
# analytics.google.com → Administrar → Flujos de datos → tu flujo web.
# Lleva prefijo PUBLIC_ porque se usa en el navegador (no es un secreto: se ve en
# el HTML de cualquier web que use GA).
#
# SIN esta variable, GA4 no existe y el banner de cookies NO se pinta: sin
# cookies no hay nada que consentir, y el sitio sigue midiendo con la analítica
# sin cookies de Vercel. Ponerla es lo que "enciende" GA4 y el banner.
# Ver docs/GOOGLE.md.
PUBLIC_GA_MEASUREMENT_ID=

# ---- Supabase (frontend, públicas) ----
# Las consigues en supabase.com → tu proyecto → Project Settings → API
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...tu-anon-key...

# ---- Supabase (solo servidor, NUNCA exponer en el navegador) ----
# Se usa en el webhook de Stripe: escribe en `subscriptions` y crea usuarios.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role...

# ---- Resend (solo servidor) ----
# API key de Resend (dominio emilseriosacademy.com ya verificado). Con ella, el
# correo de bienvenida al pagar se envía en el idioma correcto (ES/EN) con el copy
# de Emi. Si falta, el webhook cae al correo estándar de Supabase (plantilla única).
# La creas en resend.com → API Keys. Ponla también en Vercel.
RESEND_API_KEY=re_...
# Remitente (debe ser del dominio verificado en Resend). Opcional; este es el valor por defecto.
RESEND_FROM=Emilse Rios <info@emilseriosacademy.com>

# ---- Stripe (solo servidor) ----
# Dashboard de Stripe (empieza en modo TEST). Ver docs/STRIPE.md.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs de los dos Prices ya creados (price_..., no prod_...).
STRIPE_PRICE_FOUNDER=price_...   # $57/mes (fundador)
STRIPE_PRICE_STANDARD=price_...  # $80/mes (estándar)
# Opcional: fin de la ventana del precio fundador (ISO, zona de Madrid).
# now <= límite → checkout con $57; después → $80. Por defecto 2025-07-10T23:59:59+02:00.
STRIPE_FOUNDER_UNTIL=2025-07-10T23:59:59+02:00
