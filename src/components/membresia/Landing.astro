<script is:inline define:vars={{ closesAt: CLOSES_AT, reopensAt: REOPENS_AT,
                                 locale: madridLocale, payHrefOpen: t.payHref,
                                 paseParam: INVITE_PARAM,
                                 copy: { leadToday: t.closeLeadToday, leadDay: t.closeLeadDay } }}>
  // Puertas de la membresía en el cliente — cuenta atrás + cierre en vivo.
  //
  // Por qué en el navegador y no solo en el build: si el estado se horneara, la
  // carta seguiría diciendo «entra» hasta el siguiente deploy. Así el corte
  // ocurre en el segundo exacto, y a quien tenga la página abierta se le cierran
  // las puertas delante. El cobro NO depende de esto: /api/checkout comprueba las
  // mismas fechas en el servidor (src/lib/membership.ts).
  //
  // Todo el texto se formatea en la hora de MADRID (la promesa está escrita en la
  // hora de Emi: «23:59 CEST»); el contador usa la diferencia entre dos instantes,
  // que es la misma en cualquier huso, así que sirve igual en Caracas o en Tokio.
  (function () {
    var main = document.querySelector('.page');
    if (!main) return;
    var closes = Date.parse(closesAt);
    var reopens = Date.parse(reopensAt);

    // Pase de invitación (?pase=…): quien llega con uno ve la carta ABIERTA y sus
    // botones se lo llevan al checkout. Aquí NO se comprueba el código —hacerlo
    // exigiría traer el secreto al navegador, o sea publicarlo—; quien decide es
    // /api/checkout en el servidor. Un `?pase=loquesea` inventado, por tanto, solo
    // consigue ver los botones encendidos y chocar con el 403 de puertas cerradas.
    var pase = '';
    try { pase = new URLSearchParams(location.search).get(paseParam) || ''; } catch (e) {}
    var payHref = pase ? payHrefOpen + '&' + paseParam + '=' + encodeURIComponent(pase) : payHrefOpen;
    var MADRID = 'Europe/Madrid';
    var dayOpts = { timeZone: MADRID, year: 'numeric', month: '2-digit', day: '2-digit' };
    var timeOpts = { timeZone: MADRID, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' };
    var dateOpts = { timeZone: MADRID, day: 'numeric', month: 'long' };

    // Si el navegador no sabe de husos horarios, devolvemos '' y dejamos intacto
    // el texto del build (que ya trae la fecha bien): mejor eso que un hueco.
    function part(ms, opts, loc) {
      try { return new Intl.DateTimeFormat(loc || locale, opts).format(new Date(ms)); }
      catch (e) { return ''; }
    }
    function tzName(ms) {
      try {
        var ps = new Intl.DateTimeFormat('en-US', { timeZone: MADRID, timeZoneName: 'longOffset' })
          .formatToParts(new Date(ms));
        for (var i = 0; i < ps.length; i++) {
          if (ps[i].type === 'timeZoneName') return ps[i].value === 'GMT+01:00' ? 'CET' : 'CEST';
        }
      } catch (e) {}
      return 'CEST';
    }
    // «Cierra hoy» solo si el cierre cae hoy EN MADRID, no en el huso del que lee.
    function leadText(now) {
      var date = part(closes, dateOpts), time = part(closes, timeOpts);
      if (!date || !time) return '';
      var sameDay = part(closes, dayOpts, 'en-CA') === part(now, dayOpts, 'en-CA');
      return (sameDay ? copy.leadToday : copy.leadDay)
        .replace('{date}', date).replace('{time}', time).replace('{tz}', tzName(closes));
    }

    function doorsState(now) {
      if (isNaN(closes)) return 'open';
      if (now <= closes) return 'soon';
      if (!isNaN(reopens) && now >= reopens) return 'open';
      return pase ? 'open' : 'closed';
    }

    var leads = main.querySelectorAll('.timer__lead');
    var dboxes = main.querySelectorAll('[data-cd-dbox]');
    var ds = main.querySelectorAll('[data-cd-d]');
    var hs = main.querySelectorAll('[data-cd-h]');
    var ms_ = main.querySelectorAll('[data-cd-m]');
    var ss = main.querySelectorAll('[data-cd-s]');
    function each(list, fn) { for (var i = 0; i < list.length; i++) fn(list[i]); }
    function setText(list, txt) { each(list, function (el) { if (el.textContent !== txt) el.textContent = txt; }); }
    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    var lastState = '';
    var lastLead = '';
    function tick() {
      var now = Date.now();
      var st = doorsState(now);
      if (st !== lastState) {
        lastState = st;
        main.setAttribute('data-doors', st);
        // No basta con apagarlo en CSS: al cerrar le quitamos el href para que
        // tampoco se pueda abrir con el teclado, con el menú del botón derecho ni
        // copiarlo. Y al revés, si reabre con la página abierta, se lo devolvemos.
        each(main.querySelectorAll('.btn--pay'), function (b) {
          if (st === 'closed') {
            b.removeAttribute('href');
            b.setAttribute('aria-disabled', 'true');
            b.setAttribute('tabindex', '-1');
          } else {
            b.setAttribute('href', payHref);
            b.removeAttribute('aria-disabled');
            b.removeAttribute('tabindex');
          }
        });
      }
      if (st !== 'soon') return;
      var lead = leadText(now);
      if (lead && lead !== lastLead) { lastLead = lead; setText(leads, lead); }
      var left = Math.max(0, Math.floor((closes - now) / 1000));
      var d = Math.floor(left / 86400);
      setText(ds, String(d));
      each(dboxes, function (el) { el.hidden = d === 0; });
      setText(hs, pad(Math.floor((left % 86400) / 3600)));
      setText(ms_, pad(Math.floor((left % 3600) / 60)));
      setText(ss, pad(left % 60));
    }

    tick();
    setInterval(tick, 1000);
  })();
</script>

<script is:inline>
  // 13 · Fundido al hacer scroll + notas musicales al hover de los botones.
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Reveal por IntersectionObserver
    var revs = document.querySelectorAll('.reveal');
    if (reduce || !('IntersectionObserver' in window)) {
      revs.forEach(function (el) { el.classList.add('is-visible'); });
    } else {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
      revs.forEach(function (el) { io.observe(el); });
    }

    var fine = window.matchMedia('(pointer: fine)').matches;

    // Relleno de tinta que crece desde el cursor (--mx/--my) + magnético sutil.
    document.querySelectorAll('.btn').forEach(function (btn) {
      btn.addEventListener('pointermove', function (e) {
        var r = btn.getBoundingClientRect();
        var x = e.clientX - r.left, y = e.clientY - r.top;
        btn.style.setProperty('--mx', x + 'px');
        btn.style.setProperty('--my', y + 'px');
        if (fine && !reduce) {
          var dx = (x - r.width / 2) / r.width, dy = (y - r.height / 2) / r.height;
          btn.style.transform = 'translate(' + (dx * 8).toFixed(1) + 'px,' + (dy * 6).toFixed(1) + 'px)';
        }
      });
      btn.addEventListener('pointerleave', function () { btn.style.transform = ''; });
    });

    // Notas musicales de colores que salen de los botones al hacer hover.
    if (!reduce && fine) {
      var GLYPHS = ['♪', '♫', '♩', '♬'];
      var COLORS = ['#a94f2b', '#6b3f2a', '#c9a24a', '#7a8b5a', '#4a6d8c', '#b5504a'];
      function pop(btn) {
        var r = btn.getBoundingClientRect();
        var count = 2 + Math.floor(Math.random() * 2);
        for (var i = 0; i < count; i++) {
          var s = document.createElement('span');
          s.className = 'note-pop';
          s.textContent = GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
          s.style.left = (r.left + 12 + Math.random() * (r.width - 24)) + 'px';
          s.style.top = (r.top + r.height * 0.3) + 'px';
          s.style.color = COLORS[Math.floor(Math.random() * COLORS.length)];
          s.style.fontSize = (15 + Math.random() * 13) + 'px';
          s.style.setProperty('--dx', ((Math.random() * 2 - 1) * 46).toFixed(0) + 'px');
          s.style.setProperty('--rot', ((Math.random() * 2 - 1) * 40).toFixed(0) + 'deg');
          document.body.appendChild(s);
          s.addEventListener('animationend', function () { this.remove(); });
        }
      }
      document.querySelectorAll('.btn').forEach(function (btn) {
        var timer = null;
        btn.addEventListener('pointerenter', function () {
          pop(btn);
          timer = setInterval(function () { pop(btn); }, 460);
        });
        btn.addEventListener('pointerleave', function () { if (timer) { clearInterval(timer); timer = null; } });
      });
    }
  })();
</script>
<script is:inline>
  (function () {
    // Cambio de idioma EN/ES sin volver al inicio. Las dos páginas son SSR
    // independientes (/ y /en/): al togglear guardamos DÓNDE está el scroll
    // (anclado a un bloque + offset, porque el texto mide distinto entre
    // idiomas), hacemos fade-out, navegamos, y en la otra página restauramos
    // la posición y hacemos fade-in.
    var page = document.querySelector('.page');
    var html = document.documentElement;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function blocks() { return page ? Array.prototype.slice.call(page.children) : []; }
    function absTop(el) { return el.getBoundingClientRect().top + (window.scrollY || window.pageYOffset || 0); }

    // AL ENTRAR: si venimos de un toggle, restaurar posición y revelar.
    try {
      var saved = sessionStorage.getItem('langSwitch');
      if (saved) {
        sessionStorage.removeItem('langSwitch');
        var d = JSON.parse(saved);
        var bs = blocks();
        var anchor = bs[d.i];
        var y = anchor ? absTop(anchor) + d.d : d.y;
        var prev = html.style.scrollBehavior; html.style.scrollBehavior = 'auto';
        window.scrollTo(0, Math.max(0, y));
        html.style.scrollBehavior = prev;
        requestAnimationFrame(function () { html.classList.remove('lang-enter'); });
      } else {
        html.classList.remove('lang-enter');
      }
    } catch (e) { html.classList.remove('lang-enter'); }

    // AL SALIR: guardar sección/offset, fade-out y navegar.
    document.querySelectorAll('[data-lang-switch]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        if (a.getAttribute('aria-current') === 'true') return; // ya estamos en ese idioma
        var href = a.getAttribute('href');
        var bs = blocks();
        var sy = window.scrollY || window.pageYOffset || 0;
        var idx = 0;
        for (var k = 0; k < bs.length; k++) { if (absTop(bs[k]) <= sy + 2) idx = k; else break; }
        var delta = bs[idx] ? sy - absTop(bs[idx]) : 0;
        try { sessionStorage.setItem('langSwitch', JSON.stringify({ i: idx, d: delta, y: sy })); } catch (err) {}
        if (page && !reduce) page.classList.add('is-leaving');
        setTimeout(function () { window.location.href = href; }, reduce ? 0 : 300);
      });
    });
  })();
</script>
