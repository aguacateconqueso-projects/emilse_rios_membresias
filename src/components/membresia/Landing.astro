// Página de ventas de la membresía «Estudiemos Juntos» — componente bilingüe
// (prop lang: 'es' | 'en'). Rutas: / (es) y /en/ (en).
//
// PRINCIPIO (ajustes de fluidez, brief jul 2026): la carta ahora RESPIRA y
// seduce. Sigue siendo una columna de lectura, pero con jerarquía y ritmo:
// el logo en el hero, la foto, la frase de apertura grande en cursiva, los dos
// descubrimientos con protagonismo, la tarjeta de precio de dos columnas que se
// invierte de color al pasar el cursor, FAQ desplegable, y fundidos al hacer scroll.
// Paleta monocromática (tinta/crema); botones cuadrados con relleno de tinta que crece
// desde el cursor + flecha (referencia de Emi) y notas musicales al hover. Cursor de
// clave de fa. Único toque de color de texto: el marrón del instrumento en los hovers
// (apertura, cierre).
// NOTA: los botones de pago ya apuntan al checkout real de Stripe
// (/api/checkout?lang=es|en, GET que redirige a la página de pago). El newsletter
// apunta al alta real (Klaviyo/kmail).
import Analitica from '../Analitica.astro';
import { CLOSES_AT, REOPENS_AT, NEWSLETTER_URL, INVITE_PARAM, doorsClosed } from '../../lib/membership';

interface Props { lang?: 'es' | 'en'; }
const { lang = 'es' } = Astro.props;
const isEN = lang === 'en';
const other = isEN ? '/' : '/en/';
const newsHref = NEWSLETTER_URL;

// ---------------------------------------------------------------------------
// SEO — lo que Google necesita para indexar esta carta (ver docs/GOOGLE.md).
// El origen sale de `site` en astro.config.mjs (canónico CON `www`; el ápice
// pelado responde 308 en Vercel). Las rutas se derivan del idioma en vez de
// leer Astro.url para que no dependan de la barra final.
// ---------------------------------------------------------------------------
const SITE = Astro.site?.origin ?? 'https://www.emilseriosacademy.com';
const urlES = `${SITE}/`;
const urlEN = `${SITE}/en/`;
const canonical = isEN ? urlEN : urlES;
// Imagen de las tarjetas al compartir (WhatsApp, X, Facebook…). Es el retrato
// de Emi que ya usa el hero: vertical, así que las redes lo recortan al centro.
const ogImage = `${SITE}/img/foto.jpg`;
// Token de propiedad de Google Search Console. Se pone en Vercel como
// GOOGLE_SITE_VERIFICATION (solo el `content` del meta, no la etiqueta entera).
// Si falta, no se pinta nada: la verificación por DNS TXT no necesita esto.
const googleVerification =
  process.env.GOOGLE_SITE_VERIFICATION || import.meta.env.GOOGLE_SITE_VERIFICATION || '';

// Fin de la ventana del precio de fundador. Es la MISMA variable que usa el
// checkout (src/lib/stripe.ts): así la carta y el cobro real deciden con el
// mismo dato. El valor se hornea en el HTML en el build; el flip visual entre
// fundador y estándar lo hace un script en el cliente comparando la hora real
// con esta fecha (ver más abajo), para que cambie SOLO en el momento del corte
// sin depender de un redeploy. El estado renderizado por defecto (útil sin JS)
// se calcula aquí con la misma lógica.
const FOUNDER_UNTIL = process.env.STRIPE_FOUNDER_UNTIL || '2025-07-10T23:59:59+02:00';
const founderUntilMs = Date.parse(FOUNDER_UNTIL);
const builtIsFounder = !Number.isNaN(founderUntilMs) && Date.now() <= founderUntilMs;

// ---------------------------------------------------------------------------
// Puertas de la membresía (src/lib/membership.ts). MISMAS fechas que usa el
// checkout, para que la carta y el cobro no se desalineen ni un minuto.
//
// Tres estados, y los tres se calculan DOS veces: aquí (para el HTML del build,
// que es lo que ve quien llega sin JS) y otra vez en el navegador con la hora
// real del visitante (script `doors` más abajo), para que el cambio ocurra en el
// segundo exacto del cierre sin depender de un redeploy — igual que el flip de
// precio fundador/estándar.
//   · abierto con cuenta atrás → falta para el cierre: botones vivos + contador.
//   · abierto sin cuenta atrás → no hay cierre a la vista: botones vivos, sin contador.
//   · cerrado                  → botones muertos (sin href) + salida al newsletter.
// ---------------------------------------------------------------------------
const closesAtMs = Date.parse(CLOSES_AT);
const reopensAtMs = Date.parse(REOPENS_AT);
const builtClosed = doorsClosed();
const builtCountdown = !builtClosed && !Number.isNaN(closesAtMs) && Date.now() < closesAtMs;
const madridLocale = isEN ? 'en-US' : 'es-ES';
const MADRID = 'Europe/Madrid';

// Formatos de la hora de Madrid. Ojo: el visitante puede estar en cualquier huso,
// pero la promesa («23:59 CEST») está escrita en la hora de Emi, así que TODO el
// texto se formatea en Madrid y solo el contador usa la hora local del navegador
// (que da igual: la diferencia entre dos instantes es la misma en cualquier huso).
const fmtMadridTime = (ms: number) => new Intl.DateTimeFormat(madridLocale,
  { timeZone: MADRID, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(new Date(ms));
const fmtMadridDate = (ms: number) => new Intl.DateTimeFormat(madridLocale,
  { timeZone: MADRID, day: 'numeric', month: 'long' }).format(new Date(ms));
const madridDayKey = (ms: number) => new Intl.DateTimeFormat('en-CA',
  { timeZone: MADRID, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(ms));
// CEST en verano, CET en invierno — se deduce del desfase real de Madrid ese día,
// así el rótulo no miente cuando el cierre cae fuera del horario de verano.
const madridTz = (ms: number) => {
  const parts = new Intl.DateTimeFormat('en-US', { timeZone: MADRID, timeZoneName: 'longOffset' })
    .formatToParts(new Date(ms));
  return (parts.find((x) => x.type === 'timeZoneName')?.value === 'GMT+01:00') ? 'CET' : 'CEST';
};

