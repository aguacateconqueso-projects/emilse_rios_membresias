      (function () {
        var until = Date.parse(founderUntil);
        var isFounder = !isNaN(until) && Date.now() <= until;
        var c = isFounder ? copy.founder : copy.standard;
        var set = function (id, txt) { var el = document.getElementById(id); if (el) el.textContent = txt; };
