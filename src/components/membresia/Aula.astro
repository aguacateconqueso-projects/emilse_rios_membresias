---
// Aula (área de miembros) — componente bilingüe (prop lang: 'es' | 'en').
// Rutas: /aula/ (es) y /aula/en/ (en).
// Toggle EN/ES arriba cambia toda la experiencia (UI + foro de ese idioma).
// El video tiene además su propio selector ES/EN encima del placeholder.
// Datos reales desde Supabase: ejercicio vigente, "completado" y foro (ver el
// <script> al final). El bloque `t` de abajo es solo el texto/UI por defecto
// (lo que se ve antes de que cargue el JS); el contenido real lo pinta el script.
interface Props { lang?: 'es' | 'en'; }
const { lang = 'es' } = Astro.props;
const isEN = lang === 'en';

const t = isEN ? {
  htmlLang: 'en',
  metaTitle: 'Classroom — Let’s Study Together · Emilse Rios',
  brandSmall: 'Classroom', account: 'My account',
  home: '/aula/en/',
  eyebrow: 'Your exercise this week',
  title: 'Controlled détaché: weight and contact point',
  meta: 'Week 24 · June 12–19', tag: 'Available until Thursday',
  videoEs: 'Spanish', videoEn: 'English', nowPlaying: 'Now playing',
  playerHint: 'This week’s exercise', playerLabel: 'Video · Vimeo',
  desc: [
    'This week we work the <strong>détaché</strong> from the weight of the arm, not from hand pressure. The goal is a round, sustained sound, controlling the <strong>contact point</strong> between the bow and the string.',
    'Start slow, metronome at 60. Aim for every note to have the same body, with no involuntary accents when crossing strings. When it feels stable, build up gradually.',
    'The PDF has the fingering and rhythmic pattern to print and keep on the stand.',
  ],
  sideH: 'This week',
  points: ['Détaché at 60 bpm, relaxed arm', 'Same contact point on all 4 strings', 'No accent when crossing strings'],
  pdf: '↓ Download PDF', done: 'Mark as completed', doneOk: '✓ Completed',
  forumEyebrow: 'This week’s forum', forumH2: 'Questions & answers',
  forumNote: 'I answer on Fridays. Everyone reads the questions and answers.',
  composePlaceholder: 'Write your question about this week’s exercise…',
  composeHint: 'Visible to all members.', composeBtn: 'Post question',
  youName: 'María (you)', now: 'now', pending: 'Emilse answers on Friday.',
  answerRole: 'Answer',
  thread: [
    { ava: 'S', who: 'Sarah K.', when: '2 days ago',
      q: 'When I switch from the D string to the A I get an unwanted accent. Is it the arm or the bow speed?',
      a: 'It’s almost always speed: you accelerate right at the crossing. Try keeping the same bow speed and anticipate the change with the elbow, not the wrist. Slow first.' },
    { ava: 'J', who: 'James P.', when: '1 day ago',
      q: 'Is the metronome at 60 per quarter note or per eighth? I want to make sure I’m not going too fast.',
      a: null },
  ],
  noteHtml: '<b>No library.</b> On Thursday at 00:00 this exercise closes and the new one comes in. We work the present: only this week’s.',
  tabs: { semana: 'This week’s exercise', base: 'Core concept', bonus: 'Bonus material' },
  base: {
    eyebrow: 'Concept of the month',
    title: 'July · The foundation of legato',
    meta: 'Active all month',
    playerHint: 'Core concept',
    desc: [
      'Every month starts here. The <strong>core concept</strong> is the idea the four weekly exercises are built on — this month, a legato that stays even from the weight of the arm.',
      'Watch this first, and come back to it whenever a weekly exercise feels disconnected. The weeks are variations; this is the ground they stand on.',
    ],
    sideH: 'What it covers',
    points: ['The month’s guiding idea', 'How the weekly exercises connect', 'Watch before week 1'],
    note: '<b>One per month.</b> The core concept changes each month; the weekly exercises lean on it.',
  },
  bonus: {
    eyebrow: 'Extras',
    title: 'Bonus material',
    lead: 'Extra material Emilse adds over time — outside the weekly rhythm.',
  },
} : {
  htmlLang: 'es',
  metaTitle: 'Aula — Estudiemos Juntos · Emilse Rios',
  brandSmall: 'Aula', account: 'Mi cuenta',
  home: '/aula/',
  eyebrow: 'Tu ejercicio de esta semana',
  title: 'Détaché controlado: peso y punto de contacto',
  meta: 'Semana 24 · del 12 al 19 de junio', tag: 'Disponible hasta el jueves',
  videoEs: 'Español', videoEn: 'English', nowPlaying: 'Reproduciendo',
  playerHint: 'Ejercicio de la semana', playerLabel: 'Video · Vimeo',
  desc: [
    'Esta semana trabajamos el <strong>détaché</strong> desde el peso del brazo, no desde la presión de la mano. La idea es que el sonido nazca redondo y sostenido, controlando el <strong>punto de contacto</strong> entre el arco y la cuerda.',
    'Empieza lento, con el metrónomo a 60. Busca que cada nota tenga el mismo cuerpo, sin acentos involuntarios al cambiar de cuerda. Cuando lo sientas estable, sube de a poco.',
    'En el PDF tienes la digitación y el patrón rítmico para imprimir y tener en el atril.',
  ],
  sideH: 'Esta semana',
  points: ['Détaché a 60 bpm, brazo relajado', 'Mismo punto de contacto en las 4 cuerdas', 'Sin acento al cambiar de cuerda'],
  pdf: '↓ Descargar PDF', done: 'Marcar como completado', doneOk: '✓ Completado',
  forumEyebrow: 'Foro de la semana', forumH2: 'Preguntas y respuestas',
  forumNote: 'Respondo los viernes. Todos leen las preguntas y las respuestas.',
  composePlaceholder: 'Escribe tu pregunta sobre el ejercicio de esta semana…',
  composeHint: 'Visible para todos los miembros.', composeBtn: 'Publicar pregunta',
  youName: 'María (tú)', now: 'ahora', pending: 'Emilse responde el viernes.',
  answerRole: 'Respuesta',
  thread: [
    { ava: 'L', who: 'Lucía F.', when: 'hace 2 días',
      q: 'Cuando cambio de la cuerda Re a la La se me escapa un acento. ¿Es del brazo o de la velocidad del arco?',
      a: 'Casi siempre es velocidad: aceleras justo en el cruce. Prueba mantener la misma velocidad de arco y anticipar el cambio con el codo, no con la muñeca. Lento primero.' },
    { ava: 'D', who: 'Diego M.', when: 'hace 1 día',
      q: '¿El metrónomo a 60 es por negra o por corchea? Quiero asegurarme de no ir demasiado rápido.',
      a: null },
  ],
  noteHtml: '<b>Sin biblioteca.</b> El jueves a las 00:00 este ejercicio se cierra y entra el nuevo. Trabajamos el presente: solo lo de esta semana.',
  tabs: { semana: 'Ejercicio de la semana', base: 'Concepto Base', bonus: 'Bonus Material' },
  base: {
    eyebrow: 'Concepto del mes',
    title: 'Julio · La base del legato',
    meta: 'Vigente todo el mes',
    playerHint: 'Concepto Base',
    desc: [
      'Cada mes empieza aquí. El <strong>Concepto Base</strong> es la idea sobre la que se construyen los cuatro ejercicios de la semana — este mes, un legato que se mantiene parejo desde el peso del brazo.',
      'Míralo primero y vuelve a él cuando un ejercicio semanal se sienta desconectado. Las semanas son variaciones; esto es el piso sobre el que se apoyan.',
    ],
    sideH: 'De qué va',
    points: ['La idea que guía el mes', 'Cómo se conectan los ejercicios semanales', 'Míralo antes de la semana 1'],
    note: '<b>Uno por mes.</b> El Concepto Base cambia cada mes; los ejercicios de la semana se apoyan en él.',
  },
  bonus: {
    eyebrow: 'Extras',
    title: 'Bonus Material',
    lead: 'Material adicional que Emilse va sumando — fuera del ritmo semanal.',
  },
};
const altHref = isEN ? '/aula/' : '/aula/en/';
---
<!DOCTYPE html>
<html lang={t.htmlLang}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{t.metaTitle}</title>
<meta name="robots" content="noindex" />
<link rel="icon" href="https://emilserios.com/wp-content/uploads/2025/06/cropped-emilserios-32x32.png" sizes="32x32" />
<link rel="stylesheet" href="/colors_and_type.css" />
<link rel="stylesheet" href="/membresia-ui.css" />
<style is:inline>
  /* Paleta, cursor, botones y notas vienen de /membresia-ui.css (identidad de la carta). */
  :root { --edge: clamp(20px, 5vw, 72px); --wrap: 1080px; }
  html { scroll-behavior: smooth; }
  body { overflow-x: hidden; }
  a { color: inherit; }
  img { display: block; max-width: 100%; }
  .display { font-family: var(--font-display); font-weight: var(--weight-semibold);
             letter-spacing: -0.03em; line-height: 0.98; text-wrap: balance; }
  .ovl { font-family: var(--font-body); font-size: var(--text-sm); font-weight: var(--weight-semibold);
         letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-soft); }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding-inline: var(--edge); }

  .bar { position: sticky; top: 0; z-index: 50; background: rgba(250,247,241,0.82);
         -webkit-backdrop-filter: saturate(140%) blur(12px); backdrop-filter: saturate(140%) blur(12px);
         border-bottom: 1px solid var(--color-border); }
  .bar__in { max-width: var(--wrap); margin: 0 auto; padding: 12px var(--edge);
             display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .bar__right { display: flex; align-items: center; gap: clamp(10px, 2vw, 18px); }
  .lang { display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-body);
          font-size: var(--text-sm); font-weight: var(--weight-semibold); letter-spacing: 0.06em; }
  .lang a { text-decoration: none; padding: 3px 6px; border-radius: var(--radius-full); color: var(--color-text-soft);
            transition: color var(--duration) var(--ease); }
  .lang a[aria-current="true"] { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  .lang span { color: #c9c8c3; }
  .pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 13px; border-radius: var(--radius-full);
          border: 1px solid var(--color-border); background: var(--surface);
          font-size: var(--text-sm); font-weight: var(--weight-semibold); white-space: nowrap; }
  .pill .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ink); }
  .acct { text-decoration: none; font-size: var(--text-sm); font-weight: var(--weight-semibold);
          color: var(--color-text-soft); transition: color var(--duration) var(--ease); white-space: nowrap; }
  .acct:hover { color: var(--ink); }

  /* Logo del aula: más presencia que el resto (override local de la capa
     compartida). El texto "Aula" queda al lado en escritorio y se oculta en móvil. */
  .bar .brand-logo__img { height: clamp(30px, 4.6vw, 44px); }
  .bar .brand-logo { gap: 0.6em; }
  @media (max-width: 560px) { .bar .brand-logo small { display: none; } }

  /* Menú de cuenta (engranaje): soporte / darse de baja. */
  .gearmenu { position: relative; display: flex; }
  .gearmenu__btn { appearance: none; background: transparent; border: 0; cursor: pointer;
                   color: var(--color-text-soft); font-size: 1.05rem; line-height: 1; padding: 4px 7px;
                   border-radius: var(--radius-full); transition: color var(--duration) var(--ease), background var(--duration) var(--ease); }
  .gearmenu__btn:hover, .gearmenu__btn[aria-expanded="true"] { color: var(--ink); background: rgba(23, 20, 15, 0.06); }
  .gearmenu__list { position: absolute; top: calc(100% + 8px); right: 0; z-index: 60;
                    display: flex; flex-direction: column; min-width: 210px;
                    background: var(--paper); border: 1px solid var(--color-border); border-radius: 14px;
                    padding: 6px; box-shadow: 0 10px 30px rgba(23, 20, 15, 0.14); }
  .gearmenu__list[hidden] { display: none; }
  .gearmenu__list a, .gearmenu__item { text-decoration: none; color: var(--ink); font-size: var(--text-sm); font-weight: var(--weight-semibold);
                      padding: 10px 12px; border-radius: 9px; text-align: left; white-space: nowrap; }
  .gearmenu__list a:hover, .gearmenu__item:hover { background: rgba(23, 20, 15, 0.06); }
  .gearmenu__item { appearance: none; border: 0; background: transparent; cursor: pointer; width: 100%;
                    font-family: var(--font-body); display: block; }

  .lead { padding: clamp(32px, 6vh, 64px) 0 clamp(20px, 3vh, 32px); }
  .lead__title { font-size: clamp(2.2rem, 5.4vw, 3.8rem); margin: var(--space-4) 0 var(--space-3); }
  .lead__meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
                color: var(--color-text-soft); font-size: var(--text-base); }
  .tag { display: inline-flex; align-items: center; gap: 8px; padding: 6px 13px; border-radius: var(--radius-full);
         border: 1px solid var(--ink); font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--ink); }
  .tag .blink { width: 7px; height: 7px; border-radius: 50%; background: var(--ink); animation: blink 2.4s var(--ease) infinite; }
  @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0.25; } }

  .vtabs { display: inline-flex; gap: 4px; padding: 4px; border: 1px solid var(--color-border);
           border-radius: var(--radius-full); background: var(--surface); margin-bottom: 12px; }
  .vtab { appearance: none; border: 0; cursor: pointer; background: transparent; color: var(--color-text-soft);
          font-family: var(--font-body); font-weight: var(--weight-semibold); font-size: var(--text-sm);
          padding: 7px 16px; border-radius: var(--radius-full); transition: all 220ms var(--ease); }
  .vtab[aria-selected="true"] { background: var(--ink); color: #fff; }

  .player { position: relative; aspect-ratio: 16/9; width: 100%; background: #0c0c0c; color: #f4f3ef;
            border-radius: var(--radius-lg); overflow: hidden; display: grid; place-items: center; }
  .player__hint { position: absolute; left: 16px; top: 14px; font-size: 11px; letter-spacing: 0.16em;
                  text-transform: uppercase; color: rgba(244,243,239,0.7); }
  .player__play { width: clamp(62px, 8vw, 84px); aspect-ratio: 1; border-radius: 50%;
                  border: 1.5px solid rgba(244,243,239,0.55); display: grid; place-items: center;
                  transition: transform 360ms var(--ease), border-color 360ms var(--ease); }
  .player:hover .player__play { transform: scale(1.06); border-color: #fff; }
  .player__play::before { content: ""; border-style: solid; border-width: 11px 0 11px 18px;
                          border-color: transparent transparent transparent #f4f3ef; margin-left: 5px; }
  .player__label { position: absolute; right: 16px; bottom: 14px; font-size: 11px; letter-spacing: 0.16em;
                   text-transform: uppercase; color: rgba(244,243,239,0.7); }

  .ex { padding: clamp(24px, 4vh, 40px) 0 clamp(36px, 6vh, 64px);
        display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .ex__desc { color: #3a3a38; font-size: var(--text-md); line-height: 1.6; }
  .ex__desc p { margin-bottom: 1em; max-width: 60ch; }
  .ex__desc strong { font-weight: var(--weight-semibold); color: var(--ink); }
  .ex__side { position: sticky; top: 96px; border: 1px solid var(--color-border); border-radius: var(--radius-lg);
              padding: clamp(22px, 2.6vw, 30px); background: var(--surface); display: flex; flex-direction: column; gap: var(--space-4); }
  .ex__side h3 { font-family: var(--font-display); font-weight: var(--weight-medium); font-size: var(--text-lg); letter-spacing: -0.02em; }
  .ex__points { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 11px; }
  .ex__points li { display: grid; grid-template-columns: 18px 1fr; gap: 10px; font-size: var(--text-base); line-height: 1.4; color: #3a3a38; }
  .ex__points .tick { font-family: var(--font-display); color: var(--ink); line-height: 1.1; }

  /* .btn / --solid / --ghost / --block: definidos en /membresia-ui.css (botón editorial). */
  /* Estado "completado": vuelve al reposo claro (texto tinta sobre papel). */
  .btn--solid.is-done { --fg: var(--ink); background: var(--paper); color: var(--ink); border-color: var(--ink); }

  /* Ejercicio sin el cuadro lateral: descripción a ancho completo + botón de PDF. */
  .ex--single { display: block; }
  .ex__pdf { margin-top: clamp(20px, 3vh, 32px); }
  /* Botón de PDF deshabilitado: gris, sin relleno animado, no clicable (cuando el
     ejercicio no trae PDF). El .btn__fill que inyecta membresia-ui.js queda oculto. */
  .btn.is-nopdf { color: var(--color-text-soft); border-color: var(--color-border);
                  background: var(--surface); pointer-events: none; cursor: default; }
  .btn.is-nopdf .btn__fill { display: none; }

  .forum { border-top: 1px solid var(--ink); padding: clamp(40px, 7vh, 72px) 0 clamp(56px, 9vh, 96px); }
  .forum__head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4);
                 flex-wrap: wrap; margin-bottom: var(--space-5); }
  .forum__head h2 { font-family: var(--font-display); font-weight: var(--weight-medium);
                    font-size: clamp(1.7rem, 3.4vw, 2.6rem); letter-spacing: -0.03em; }
  .forum__note { color: var(--color-text-soft); font-size: var(--text-base); max-width: 30ch; text-align: right; }
  .compose { border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: clamp(16px, 2vw, 22px);
             background: var(--surface); margin-bottom: var(--space-6); }
  .compose textarea { width: 100%; border: 0; background: transparent; resize: vertical; min-height: 76px;
                      font-family: var(--font-body); font-size: var(--text-md); color: var(--ink); line-height: 1.5; }
  .compose textarea:focus { outline: none; }
  .compose textarea::placeholder { color: #a4a39e; }
  .compose__row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
                  border-top: 1px solid var(--color-border); padding-top: var(--space-3); margin-top: var(--space-2); }
  .compose__hint { font-size: var(--text-sm); color: var(--color-text-soft); }

  .thread { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .q { padding: var(--space-5) 0; border-bottom: 1px solid var(--color-border); }
  .q__top { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .ava { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; flex: none;
         font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 14px;
         background: var(--surface); border: 1px solid var(--color-border); }
  .q__who { font-weight: var(--weight-semibold); font-size: var(--text-base); }
  .q__when { color: var(--color-text-soft); font-size: var(--text-sm); }
  .q__body { font-size: var(--text-md); line-height: 1.55; color: #2c2c2a; max-width: 62ch; }
  .answer { margin: var(--space-4) 0 0 clamp(0px, 2vw, 46px); padding: var(--space-4);
            background: var(--ink); color: #f4f3ef; border-radius: var(--radius-lg); max-width: 64ch; }
  .answer .q__top { margin-bottom: 10px; }
  .answer .ava { background: #f4f3ef; color: var(--ink); border: 0; }
  .answer .q__who { color: #fff; }
  .answer .q__role { color: #b9b8b3; font-size: var(--text-sm); }
  .answer .q__body { color: #e7e6e2; }
  .answer--pending { background: transparent; color: var(--color-text-soft); border: 1px dashed var(--color-border);
                     font-size: var(--text-sm); display: flex; align-items: center; gap: 10px; }
  .answer--pending .ava { background: var(--surface); color: var(--color-text-soft); border: 1px dashed var(--color-border); }

  .note-strip { border-top: 1px solid var(--color-border); padding: clamp(28px, 4vh, 44px) 0; }
  .note-strip p { color: var(--color-text-soft); font-size: var(--text-base); max-width: 60ch; }
  .note-strip b { color: var(--ink); font-weight: var(--weight-semibold); }

  /* --- Pestañas del aula: Ejercicio de la semana / Concepto Base / Bonus --- */
  .tabs { display: flex; gap: clamp(16px, 3vw, 34px); border-bottom: 1px solid var(--color-border);
          margin-top: clamp(18px, 3.5vh, 34px); overflow-x: auto; scrollbar-width: none; }
  .tabs::-webkit-scrollbar { display: none; }
  .tab { appearance: none; border: 0; background: transparent; cursor: pointer; white-space: nowrap;
         font-family: var(--font-display); font-weight: var(--weight-medium);
         font-size: clamp(1rem, 2.1vw, 1.2rem); letter-spacing: -0.015em; color: var(--color-text-soft);
         padding: 4px 0 15px; position: relative; transition: color 220ms var(--ease); }
  .tab:hover { color: var(--ink); }
  .tab[aria-selected="true"] { color: var(--ink); }
  .tab::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--ink);
                transform: scaleX(0); transform-origin: left; transition: transform 280ms var(--ease); }
  .tab[aria-selected="true"]::after { transform: scaleX(1); }
  .tabpanel[hidden] { display: none; }

  .demo-note { margin-top: var(--space-4); display: inline-block; color: var(--color-text-soft);
               font-size: var(--text-sm); border: 1px dashed var(--color-border); border-radius: var(--radius-full);
               padding: 6px 14px; }

  .bonus-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: clamp(18px, 2.4vw, 28px);
                padding: clamp(8px, 2vh, 20px) 0 clamp(40px, 7vh, 80px); }
  .bonus-card { border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; background: var(--paper);
                display: flex; flex-direction: column; transition: transform 320ms var(--ease), box-shadow 320ms var(--ease); }
  .bonus-card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -28px rgba(0,0,0,0.4); }
  .bonus-card__media { position: relative; aspect-ratio: 16/9; background: #0c0c0c; display: grid; place-items: center; }
  .bonus-card__media .player__play { width: 52px; }
  .bonus-card__body { padding: clamp(16px, 1.8vw, 22px); display: flex; flex-direction: column; gap: 8px; }
  .bonus-card__title { font-family: var(--font-display); font-weight: var(--weight-medium); font-size: var(--text-lg); letter-spacing: -0.02em; }
  .bonus-card__desc { color: #3a3a38; font-size: var(--text-base); line-height: 1.5; }
  .bonus-card__langs { margin-top: 4px; font-size: var(--text-sm); font-weight: var(--weight-semibold);
                       color: var(--color-text-soft); letter-spacing: 0.08em; }
  .bonus-card__media[role="button"] { cursor: pointer; }

  /* --- Lightbox de video (Bonus Material) --- */
  .vmodal { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center;
            padding: clamp(16px, 4vw, 48px); }
  .vmodal[hidden] { display: none; }
  .vmodal__backdrop { position: absolute; inset: 0; background: rgba(12, 11, 9, 0.74);
                      -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
                      animation: vmodal-fade 240ms var(--ease); }
  .vmodal__dialog { position: relative; width: min(960px, 100%);
                    animation: vmodal-pop 320ms var(--ease); }
  .vmodal__frame { position: relative; aspect-ratio: 16/9; width: 100%; background: #0c0c0c;
                   border-radius: var(--radius-lg); overflow: hidden;
                   box-shadow: 0 30px 90px -24px rgba(0, 0, 0, 0.7); }
  .vmodal__close { position: absolute; top: -18px; right: -18px; width: 42px; height: 42px;
                   border-radius: 50%; border: 0; background: #faf7f1; color: var(--ink);
                   font-size: 26px; line-height: 1; cursor: pointer; display: grid; place-items: center;
                   box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35); transition: transform 200ms var(--ease); }
  .vmodal__close:hover { transform: scale(1.08); }
  @media (max-width: 640px) { .vmodal__close { top: 8px; right: 8px; } }
  @keyframes vmodal-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes vmodal-pop { from { opacity: 0; transform: translateY(14px) scale(0.96); }
                          to { opacity: 1; transform: none; } }

  @media (max-width: 860px) {
    .ex { grid-template-columns: 1fr; }
    .ex__side { position: static; }
    .forum__note { text-align: left; }
  }
  .subgate { text-align: center; max-width: 44ch; margin: clamp(24px, 6vw, 56px) auto; }
  .subgate__h { font-size: var(--text-2xl); margin-bottom: var(--space-3); }
  .subgate__p { color: var(--color-text-soft); line-height: 1.55; margin-bottom: var(--space-5); }
  .subgate .btn { min-width: min(320px, 80%); }

  /* --- Tour de bienvenida (onboarding paso a paso, estilo Figma) --------------
     Oscurece la pantalla, "ilumina" la sección de turno con un recorte + glow y
     muestra un cuadro con el paso (X de 6), el mensaje de Emi y un botón cuadrado
     (sin la animación de relleno de los .btn — es un botón aparte a propósito). */
  .tour[hidden] { display: none; }
  .tour__block { position: fixed; inset: 0; z-index: 2000; background: transparent; }
  .tour__block.is-full { background: rgba(23, 20, 15, 0.62); }
  .tour__spot { position: fixed; z-index: 2001; border-radius: 10px; pointer-events: none;
                box-shadow: 0 0 0 9999px rgba(23, 20, 15, 0.62),
                            0 0 0 2px rgba(250, 247, 241, 0.95),
                            0 0 26px 6px rgba(250, 247, 241, 0.28);
                transition: top 260ms var(--ease), left 260ms var(--ease),
                            width 260ms var(--ease), height 260ms var(--ease); }
  .tour__spot[hidden] { display: none; }
  .tour__spot.is-glow { animation: tour-glow 2.2s var(--ease) infinite; }
  @keyframes tour-glow {
    0%, 100% { box-shadow: 0 0 0 9999px rgba(23, 20, 15, 0.62), 0 0 0 2px rgba(250, 247, 241, 0.95), 0 0 22px 5px rgba(250, 247, 241, 0.22); }
    50%      { box-shadow: 0 0 0 9999px rgba(23, 20, 15, 0.62), 0 0 0 2px rgba(250, 247, 241, 1),    0 0 34px 9px rgba(250, 247, 241, 0.38); }
  }
  .tour__pop { position: fixed; z-index: 2002; width: min(340px, calc(100vw - 32px));
               background: var(--paper); border: 1px solid var(--color-border); border-radius: 12px;
               padding: clamp(18px, 2.4vw, 24px); box-shadow: 0 22px 60px rgba(23, 20, 15, 0.32);
               animation: tour-pop 240ms var(--ease); }
  @keyframes tour-pop { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; } }
  .tour__count { font-family: var(--font-body); font-size: var(--text-sm); font-weight: var(--weight-semibold);
                 letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-soft); }
  .tour__text { margin: 10px 0 18px; font-size: var(--text-md); line-height: 1.55; color: var(--ink); }
  .tour__actions { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .tour__skip { appearance: none; background: transparent; border: 0; cursor: pointer; padding: 4px 2px;
                font-family: var(--font-body); font-size: var(--text-sm); font-weight: var(--weight-semibold);
                color: var(--color-text-soft); text-decoration: underline; text-underline-offset: 3px; }
  .tour__skip:hover { color: var(--ink); }
  /* Botón cuadrado, mismo lenguaje editorial que los .btn pero SIN animación. */
  .tour__btn { appearance: none; cursor: pointer; border: 1.5px solid var(--ink); border-radius: 0;
               background: var(--ink); color: #fff; font-family: var(--font-body); font-weight: var(--weight-semibold);
               font-size: 0.78rem; letter-spacing: 0.11em; text-transform: uppercase; padding: 12px 22px; }
  .tour__btn:hover { background: #000; }
  @media (prefers-reduced-motion: reduce) { * { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; } }
</style>
</head>
<body data-page-lang={lang}>

  <header class="bar">
    <div class="bar__in">
      <a class="brand-logo" href={t.home}>
        <img class="brand-logo__img" src="/img/logo_emi_alpha.png" alt="Emilse Rios"
             onerror="this.style.display='none';var f=this.parentNode.querySelector('.brand-logo__fallback');if(f)f.hidden=false;" />
        <span class="brand-logo__fallback" hidden>Emilse Rios</span>
        <small>{t.brandSmall}</small>
      </a>
      <div class="bar__right">
        <div class="lang" aria-label="Idioma / Language">
          <a href="/aula/" aria-current={(!isEN).toString()}>ES</a>
          <span aria-hidden="true">/</span>
          <a href="/aula/en/" aria-current={isEN.toString()}>EN</a>
        </div>
        <!-- Solo Emi (admin) ve este enlace; el script lo revela tras leer el rol. -->
        <a class="acct" id="adminBack" href="/panel/" hidden>{isEN ? '← Back to panel' : '← Volver al panel'}</a>
        <!-- Solo miembros con suscripción activa; abre el portal de Stripe. -->
        <a class="acct" id="acctBilling" href="#" hidden>{isEN ? 'Subscription' : 'Suscripción'}</a>
        <!-- Menú de cuenta: soporte por correo y baja directa (link del portal de Stripe). -->
        <div class="gearmenu">
          <button type="button" class="gearmenu__btn" id="gearBtn" aria-haspopup="true" aria-expanded="false"
                  aria-label={isEN ? 'More options' : 'Más opciones'}>⚙</button>
          <div class="gearmenu__list" id="gearMenu" role="menu" hidden>
            <a role="menuitem" href="mailto:info@emilserios.com">{isEN ? 'Support' : 'Soporte'}</a>
            <button type="button" role="menuitem" id="tourReplay" class="gearmenu__item">{isEN ? 'Show tutorial' : 'Ver tutorial'}</button>
            <a role="menuitem" href="https://billing.stripe.com/p/login/bJeaEX6V7dRDaUP8Zb73G00" target="_blank" rel="noopener">{isEN ? 'Cancel subscription' : 'Darse de baja'}</a>
          </div>
        </div>
        <a class="acct" href="/salir/">{isEN ? 'Log out' : 'Salir'}</a>
      </div>
    </div>
  </header>

  <main>
    <div class="wrap">

      <!-- Puerta de suscripción: fuera de las pestañas. El script oculta pestañas +
           paneles y muestra esto solo si el miembro no tiene suscripción activa. -->
      <section class="subgate" id="subGate" hidden>
        <h2 class="subgate__h">{isEN ? 'Complete your subscription' : 'Completa tu suscripción'}</h2>
        <p class="subgate__p">{isEN
          ? 'Subscribe to unlock this week’s exercise, the video and the forum. Cancel anytime.'
          : 'Suscríbete para acceder al ejercicio de la semana, el video y el foro. Cancela cuando quieras.'}</p>
        <a class="btn btn--solid" id="subGateBtn" href={isEN ? '/api/checkout?lang=en' : '/api/checkout?lang=es'}>
          {isEN ? 'Subscribe' : 'Suscribirme'}
        </a>
      </section>

      <!-- Barra de pestañas del aula -->
      <nav class="tabs" id="tabs" role="tablist" aria-label={isEN ? 'Classroom sections' : 'Secciones del aula'}>
        <button class="tab" type="button" id="tab-semana" role="tab" aria-controls="panel-semana" aria-selected="true" data-tab="semana">{t.tabs.semana}</button>
        <button class="tab" type="button" id="tab-base" role="tab" aria-controls="panel-base" aria-selected="false" tabindex="-1" data-tab="base">{t.tabs.base}</button>
        <button class="tab" type="button" id="tab-bonus" role="tab" aria-controls="panel-bonus" aria-selected="false" tabindex="-1" data-tab="bonus">{t.tabs.bonus}</button>
      </nav>

      <!-- ===== Pestaña: Ejercicio de la semana (datos reales + foro adentro) ===== -->
      <div class="tabpanel" id="panel-semana" role="tabpanel" aria-labelledby="tab-semana" tabindex="0">

        <section class="lead reveal">
          <div class="ovl" id="greeting">{t.eyebrow}</div>
          <h1 class="lead__title display" id="exTitle">{t.title}</h1>
          <div class="lead__meta">
            <span id="exMeta">{t.meta}</span>
            <span class="tag"><span class="blink"></span> {t.tag}</span>
          </div>
        </section>

        <section aria-label="Video">
          <div class="vtabs" role="tablist" aria-label="Video language">
            <button class="vtab" type="button" aria-selected={(!isEN).toString()} data-vlang="es">{t.videoEs}</button>
            <button class="vtab" type="button" aria-selected={isEN.toString()} data-vlang="en">{t.videoEn}</button>
          </div>
          <div class="player" id="player" role="button" tabindex="0" aria-label="Play">
            <span class="player__hint">{t.playerHint}</span>
            <span class="player__play" aria-hidden="true"></span>
            <span class="player__label" id="vlabel">{t.playerLabel} · {isEN ? t.videoEn : t.videoEs}</span>
          </div>
        </section>

        <section class="ex ex--single">
          <div class="ex__desc" id="exDesc">
            {t.desc.map((p) => (<p set:html={p} />))}
          </div>
          <div class="ex__pdf">
            <a class="btn btn--ghost" id="pdfBtn" href="#" data-pdflabel={t.pdf}>{t.pdf}</a>
          </div>
        </section>

        <!-- El foro vive DENTRO del ejercicio de la semana (no es pestaña aparte). -->
        <section class="forum" id="foro">
          <div class="forum__head">
            <div>
              <span class="ovl">{t.forumEyebrow}</span>
              <h2>{t.forumH2}</h2>
            </div>
          </div>

          <form class="compose" id="composeForm">
            <textarea id="composeText" placeholder={t.composePlaceholder} aria-label="Q"></textarea>
            <div class="compose__row">
              <span class="compose__hint">{t.composeHint}</span>
              <button class="btn btn--solid" type="submit">{t.composeBtn}</button>
            </div>
          </form>

          <ul class="thread" id="thread">
            <li class="q" data-empty>
              <p class="q__body">{isEN ? 'Loading questions…' : 'Cargando preguntas…'}</p>
            </li>
          </ul>
        </section>

        <section class="note-strip">
          <p set:html={t.noteHtml} />
        </section>

      </div>

      <!-- ===== Pestaña: Concepto Base (datos reales — ver <script>) ===== -->
      <div class="tabpanel" id="panel-base" role="tabpanel" aria-labelledby="tab-base" tabindex="0" hidden>

        <section class="lead reveal">
          <div class="ovl">{t.base.eyebrow}</div>
          <h1 class="lead__title display" id="baseTitle">{t.base.title}</h1>
          <div class="lead__meta"><span id="baseMeta">{t.base.meta}</span></div>
        </section>

        <section aria-label="Video">
          <div class="vtabs" role="tablist" aria-label="Video language">
            <button class="vtab" type="button" aria-selected={(!isEN).toString()} data-vlang="es">{t.videoEs}</button>
            <button class="vtab" type="button" aria-selected={isEN.toString()} data-vlang="en">{t.videoEn}</button>
          </div>
          <div class="player" id="basePlayer">
            <span class="player__hint">{t.base.playerHint}</span>
            <span class="player__play" aria-hidden="true"></span>
            <span class="player__label" id="baseVlabel">{t.playerLabel} · {isEN ? t.videoEn : t.videoEs}</span>
          </div>
        </section>

        <section class="ex">
          <div class="ex__desc" id="baseDesc">
            {t.base.desc.map((p) => (<p set:html={p} />))}
          </div>
          <aside class="ex__side">
            <h3>{t.base.sideH}</h3>
            <ul class="ex__points">
              {t.base.points.map((p) => (<li><span class="tick">→</span> {p}</li>))}
            </ul>
            <a class="btn btn--ghost btn--block" id="basePdfBtn" href="#" data-pdflabel={t.pdf}>{t.pdf}</a>
          </aside>
        </section>

        <section class="note-strip">
          <p set:html={t.base.note} />
        </section>
      </div>

      <!-- ===== Pestaña: Bonus Material (datos reales — ver <script>) ===== -->
      <div class="tabpanel" id="panel-bonus" role="tabpanel" aria-labelledby="tab-bonus" tabindex="0" hidden>

        <section class="lead reveal">
          <div class="ovl">{t.bonus.eyebrow}</div>
          <h1 class="lead__title display">{t.bonus.title}</h1>
          <div class="lead__meta"><span>{t.bonus.lead}</span></div>
        </section>

        <section class="bonus-grid" id="bonusGrid" aria-label={t.bonus.title}>
          <p class="demo-note" id="bonusEmpty">{isEN ? 'Loading…' : 'Cargando…'}</p>
        </section>
      </div>

    </div>
  </main>

  <!-- Lightbox de video (Bonus Material): el video del panel se ve pequeño dentro de
       la tarjeta; al hacer clic se abre aquí a tamaño grande, con una X arriba a la
       derecha para salir. Se cierra con la X, clic en el fondo o Escape. -->
  <div class="vmodal" id="vmodal" role="dialog" aria-modal="true" aria-label={t.bonus.title} hidden>
    <div class="vmodal__backdrop" data-vclose></div>
    <div class="vmodal__dialog">
      <button class="vmodal__close" id="vmodalClose" type="button" aria-label={isEN ? 'Close' : 'Cerrar'}>&times;</button>
      <div class="vmodal__frame" id="vmodalFrame"></div>
    </div>
  </div>

<!-- Datos reales: login + ejercicio vigente + foro, desde Supabase -->
<script>
  import { supabase } from '../../lib/supabase';

  const pageLang = document.body.dataset.pageLang === 'en' ? 'en' : 'es';
  const EN = pageLang === 'en';
  const $ = (id) => document.getElementById(id);

  // --- Pestañas del aula (Ejercicio de la semana / Concepto Base / Bonus) ---
  // Puro UI: funciona aunque el resto (datos reales) aún esté cargando.
  (function tabsInit() {
    const tablist = $('tabs');
    if (!tablist) return;
    const tabs = Array.from(tablist.querySelectorAll('.tab'));
    const panelOf = (name) => $('panel-' + name);
    function select(name, focus) {
      tabs.forEach((tab) => {
        const on = tab.dataset.tab === name;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        const p = panelOf(tab.dataset.tab);
        if (p) p.hidden = !on;
        if (on && focus) tab.focus();
      });
      if (history.replaceState) history.replaceState(null, '', '#' + name);
      window.scrollTo({ top: 0, behavior: 'auto' });
    }
    tabs.forEach((tab) => tab.addEventListener('click', () => select(tab.dataset.tab)));
    tablist.addEventListener('keydown', (e) => {
      const i = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      if (e.key === 'ArrowRight') { e.preventDefault(); select(tabs[(i + 1) % tabs.length].dataset.tab, true); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); select(tabs[(i - 1 + tabs.length) % tabs.length].dataset.tab, true); }
    });
    // Deep-link por hash (#base / #bonus) al cargar.
    const initial = (location.hash || '').replace('#', '');
    if (initial && initial !== 'semana' && panelOf(initial)) select(initial);
  })();

  // Toggles ES/EN de las maquetas (Base/Bonus): solo visual, sin cargar video.
  document.querySelectorAll('.tabpanel:not(#panel-semana) .vtabs').forEach((group) => {
    group.querySelectorAll('.vtab').forEach((tab) => {
      tab.addEventListener('click', () => {
        group.querySelectorAll('.vtab').forEach((x) => x.setAttribute('aria-selected', x === tab ? 'true' : 'false'));
      });
    });
  });

  const T = {
    locked: EN
      ? 'No exercise available. Your subscription may be inactive.'
      : 'No hay ejercicio disponible. Puede que tu suscripción no esté activa.',
    greeting: EN ? 'Your exercise this week' : 'Tu ejercicio de esta semana',
    doneTxt: EN ? 'Mark as completed' : 'Marcar como completado',
    doneOk: EN ? '✓ Completed' : '✓ Completado',
    answerRole: EN ? 'Answer' : 'Respuesta',
    pending: EN ? 'Emilse will reply soon.' : 'Emilse responderá pronto.',
    you: EN ? 'you' : 'tú',
    emptyForum: EN ? 'No questions yet. Be the first to ask.' : 'Aún no hay preguntas. Sé el primero en preguntar.',
    forumError: EN ? 'Couldn’t load the forum.' : 'No se pudo cargar el foro.',
    postError: EN ? 'Couldn’t post your question. Try again.' : 'No se pudo publicar tu pregunta. Inténtalo de nuevo.',
    sending: EN ? 'Posting…' : 'Publicando…',
    baseLocked: EN ? 'No core concept available yet.' : 'Aún no hay Concepto Base disponible.',
    bonusEmpty: EN ? 'No bonus material yet.' : 'Aún no hay Bonus Material.',
    bonusLoadError: EN ? 'Couldn’t load the bonus material.' : 'No se pudo cargar el Bonus Material.',
    videoUnavailable: EN
      ? 'This video could not be loaded. Check the Vimeo link in the panel.'
      : 'No se pudo cargar el video. Revisa el enlace de Vimeo en el panel.',
    noPdf: EN ? 'No PDF for this exercise' : 'Sin PDF para este ejercicio',
  };

  // Nombre a mostrar: "Nombre Inicial." (sin correo). Si no hay nombre, parte del correo.
  function displayName(p) {
    const full = ((p && p.full_name) || '').trim();
    if (full) {
      const parts = full.split(/\s+/);
      return parts.length > 1 ? `${parts[0]} ${parts[1][0].toUpperCase()}.` : parts[0];
    }
    return ((p && p.email) || '').split('@')[0] || (EN ? 'Member' : 'Miembro');
  }

  function timeAgo(iso) {
    const secs = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
    const mins = Math.floor(secs / 60), hrs = Math.floor(secs / 3600), days = Math.floor(secs / 86400);
    if (secs < 60) return EN ? 'now' : 'ahora';
    if (mins < 60) return EN ? `${mins} min ago` : `hace ${mins} min`;
    if (hrs < 24) return EN ? `${hrs} h ago` : `hace ${hrs} h`;
    if (days === 1) return EN ? '1 day ago' : 'hace 1 día';
    return EN ? `${days} days ago` : `hace ${days} días`;
  }
  const avatarLetter = (name) => ((name || '?').trim()[0] || '?').toUpperCase();

  // Convierte cualquier forma de enlace de Vimeo en la URL de embed del player.
  // Tolera lo que Emi pueda pegar: enlace normal, enlace del panel
  // (vimeo.com/manage/videos/ID), player.vimeo.com/video/ID, ID pelado, código
  // <iframe> completo, y el hash de video oculto tanto en la ruta (/ID/HASH)
  // como en query (?h=HASH). Devuelve null si no encuentra un ID válido.
  function vimeoEmbed(url) {
    if (!url) return null;
    let s = String(url).trim();
    // Si pegaron el código <iframe … src="…">, usa el src.
    const src = s.match(/src=["']([^"']+)["']/i);
    if (src) s = src[1];
    // Si vino de HTML pegado, las & llegan como &amp;: decodifícalas.
    s = s.replace(/&amp;/g, '&');
    // ID del video: primera secuencia larga de dígitos (los IDs de Vimeo son 6-11).
    const id = s.match(/\d{6,}/);
    if (!id) return null;
    const base = 'https://player.vimeo.com/video/' + id[0];
    // Conserva la query tal cual la da Vimeo (?h=, app_id, etc.) para que el embed
    // se comporte igual que su código oficial. Si no hay query pero el hash viene
    // en la ruta (/ID/HASH, video oculto), pásalo como ?h=.
    const qi = s.indexOf('?');
    if (qi !== -1) return base + s.slice(qi);
    const ph = s.match(new RegExp('/' + id[0] + '/([A-Za-z0-9]+)'));
    return base + (ph ? '?h=' + ph[1] : '');
  }

  // Pinta un iframe de Vimeo dentro de `player` (o un aviso si la URL no se pudo
  // interpretar). Compartido por Ejercicio de la semana, Concepto Base y las
  // tarjetas de Bonus Material.
  function embedPlayer(player, url) {
    if (!player) return;
    const embed = vimeoEmbed(url);
    if (embed) {
      const iframe = document.createElement('iframe');
      iframe.src = embed;
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
      iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share');
      // Vimeo valida el dominio permitido por el origen (referrer). Sin esto, un
      // video restringido por dominio se bloquea aunque el dominio esté en la lista.
      iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      iframe.allowFullscreen = true;
      player.replaceChildren(iframe);
    } else if (url) {
      // Hay URL pero no se pudo interpretar: no dejar un botón de play muerto.
      const msg = document.createElement('div');
      msg.style.cssText = 'position:absolute;inset:0;display:grid;place-items:center;padding:20px;text-align:center;font-size:13px;line-height:1.5';
      msg.textContent = T.videoUnavailable;
      player.replaceChildren(msg);
    }
    // Si no hay URL para ese idioma, se deja el placeholder tal cual.
  }

  // Botón de PDF (Supabase Storage). Con archivo: enlace de descarga real. Sin
  // archivo: botón gris deshabilitado "Sin PDF para este ejercicio" (no se oculta,
  // así el miembro sabe que este ejercicio simplemente no trae PDF).
  function wirePdfButton(btn, path) {
    if (!btn) return;
    const label = btn.dataset.pdflabel || btn.textContent;
    if (path) {
      const { data } = supabase.storage.from('pdfs').getPublicUrl(path);
      btn.href = data.publicUrl; btn.target = '_blank'; btn.rel = 'noopener';
      btn.classList.remove('is-nopdf'); btn.removeAttribute('aria-disabled');
      btn.textContent = label;
    } else {
      btn.removeAttribute('href'); btn.removeAttribute('target'); btn.removeAttribute('rel');
      btn.classList.add('is-nopdf'); btn.setAttribute('aria-disabled', 'true');
      btn.textContent = T.noPdf;
    }
  }

  // Con suscripción (o admin) pero sin Concepto Base vigente: mensaje en su pestaña.
  function showBaseLocked() {
    const title = $('baseTitle'); if (title) title.textContent = T.baseLocked;
    const descEl = $('baseDesc'); if (descEl) descEl.innerHTML = '';
    document.querySelectorAll('#panel-base section[aria-label="Video"], #panel-base .ex, #panel-base .note-strip')
      .forEach((s) => { s.style.display = 'none'; });
  }

  // Concepto Base: el que está "vigente" (mismo mecanismo de ventana que la
  // semana, pero pensado para un rango mensual). No bloquea el resto del aula.
  async function loadBaseConcept() {
    const nowISO = new Date().toISOString();
    const { data, error } = await supabase
      .from('exercises').select('*')
      .eq('kind', 'base')
      .lte('publish_at', nowISO)
      .gt('unpublish_at', nowISO)
      .order('publish_at', { ascending: false })
      .limit(1);
    if (error) { console.error('[aula] base error:', error); return; }
    const b = data && data[0];
    if (!b) { showBaseLocked(); return; }

    $('baseTitle').textContent = EN ? b.title_en : b.title_es;
    if ($('baseMeta')) $('baseMeta').textContent = b.week_label || '';
    const desc = (EN ? b.desc_en : b.desc_es) || '';
    const descEl = $('baseDesc');
    if (descEl) {
      descEl.innerHTML = '';
      desc.split(/\n\s*\n|\n/).filter((p) => p.trim()).forEach((p) => {
        const el = document.createElement('p'); el.textContent = p.trim(); descEl.appendChild(el);
      });
    }

    const renderBaseVideo = (which) => embedPlayer($('basePlayer'), which === 'en' ? b.vimeo_url_en : b.vimeo_url_es);
    renderBaseVideo(pageLang);
    document.querySelectorAll('#panel-base .vtab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('#panel-base .vtab').forEach((x) => x.setAttribute('aria-selected', x === tab ? 'true' : 'false'));
        renderBaseVideo(tab.dataset.vlang);
      });
    });

    wirePdfButton($('basePdfBtn'), EN ? b.pdf_path_en : b.pdf_path_es);
  }

  function bonusMsg(text) {
    const p = document.createElement('p'); p.className = 'demo-note'; p.textContent = text; return p;
  }

  // Lightbox de video (Bonus Material): abre el video en grande sobre un fondo
  // oscuro con una X para salir. Reusa embedPlayer (mismo iframe de Vimeo).
  let lastFocused = null;
  function openVideoModal(url) {
    const modal = $('vmodal'), frame = $('vmodalFrame');
    if (!modal || !frame) return;
    lastFocused = document.activeElement;
    embedPlayer(frame, url);
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    const close = $('vmodalClose'); if (close) close.focus();
  }
  function closeVideoModal() {
    const modal = $('vmodal'), frame = $('vmodalFrame');
    if (!modal || modal.hidden) return;
    modal.hidden = true;
    if (frame) frame.replaceChildren();   // detiene la reproducción
    document.body.style.overflow = '';
    if (lastFocused && lastFocused.focus) lastFocused.focus();
  }
  (function wireVideoModal() {
    const modal = $('vmodal'), close = $('vmodalClose');
    if (!modal) return;
    if (close) close.addEventListener('click', closeVideoModal);
    modal.addEventListener('click', (e) => { if (e.target.hasAttribute('data-vclose')) closeVideoModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeVideoModal(); });
  })();

  // Una tarjeta de Bonus Material: el video se carga recién al hacer clic (son
  // varias tarjetas en la grilla, no tiene sentido pintar N iframes de una).
  function renderBonusCard(b) {
    const art = document.createElement('article'); art.className = 'bonus-card reveal';
    const media = document.createElement('div'); media.className = 'bonus-card__media';
    const play = document.createElement('span'); play.className = 'player__play'; play.setAttribute('aria-hidden', 'true');
    media.appendChild(play);

    const url = EN ? b.vimeo_url_en : b.vimeo_url_es;
    if (vimeoEmbed(url)) {
      media.setAttribute('role', 'button'); media.tabIndex = 0; media.setAttribute('aria-label', 'Play');
      const open = () => openVideoModal(url);
      media.addEventListener('click', open);
      media.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
    }

    const body = document.createElement('div'); body.className = 'bonus-card__body';
    const tag = document.createElement('span'); tag.className = 'ovl'; tag.textContent = b.week_label || '';
    const h3 = document.createElement('h3'); h3.className = 'bonus-card__title'; h3.textContent = EN ? b.title_en : b.title_es;
    const desc = document.createElement('p'); desc.className = 'bonus-card__desc'; desc.textContent = (EN ? b.desc_en : b.desc_es) || '';
    const langs = document.createElement('span'); langs.className = 'bonus-card__langs'; langs.textContent = 'ES · EN';
    body.append(tag, h3, desc, langs);

    art.append(media, body);
    return art;
  }

  // Bonus Material: se acumula, no expira una vez publicado. Orden: el más
  // viejo primero (el video de bienvenida, si existe, queda arriba).
  async function loadBonusMaterial() {
    const grid = $('bonusGrid');
    if (!grid) return;
    const nowISO = new Date().toISOString();
    const { data, error } = await supabase
      .from('exercises').select('*')
      .eq('kind', 'bonus')
      .lte('publish_at', nowISO)
      .order('publish_at', { ascending: true });
    if (error) { console.error('[aula] bonus error:', error); grid.replaceChildren(bonusMsg(T.bonusLoadError)); return; }
    const items = data || [];
    if (!items.length) { grid.replaceChildren(bonusMsg(T.bonusEmpty)); return; }
    grid.replaceChildren(...items.map(renderBonusCard));
  }

  // Con suscripción (o admin) pero sin ejercicio en ventana: la pestaña "Ejercicio
  // de la semana" muestra el aviso, pero las demás pestañas siguen accesibles.
  function showLocked() {
    $('exTitle').textContent = T.locked;
    ['exDesc'].forEach((id) => { const el = $(id); if (el) el.innerHTML = ''; });
    document.querySelectorAll('#panel-semana section[aria-label="Video"], #panel-semana .ex, #panel-semana .forum, #panel-semana .note-strip')
      .forEach((s) => { s.style.display = 'none'; });
  }

  // Miembro sin suscripción activa: sin acceso a nada. Oculta pestañas + paneles y
  // muestra solo la puerta de pago.
  function showSubscribeGate() {
    const tabs = $('tabs'); if (tabs) tabs.style.display = 'none';
    document.querySelectorAll('.tabpanel').forEach((p) => { p.hidden = true; });
    const g = $('subGate'); if (g) g.hidden = false;
  }

  // ¿La fila de suscripción está activa ahora mismo?
  function isActiveSub(s) {
    return !!(s && s.status === 'active' &&
      (!s.current_period_end || new Date(s.current_period_end) > new Date()));
  }

  // Última fila de suscripción del miembro (RLS: cada quien lee solo la suya).
  async function loadSub() {
    const { data } = await supabase
      .from('subscriptions')
      .select('status, current_period_end, stripe_customer_id')
      .order('updated_at', { ascending: false })
      .limit(1);
    return data && data[0];
  }

  // Promesa que se rinde tras `ms` para no quedarse colgado si Supabase no responde.
  function withTimeout(promise, ms, label) {
    return Promise.race([
      promise,
      new Promise((_, reject) => setTimeout(() => reject(new Error('Tiempo de espera agotado (' + label + ')')), ms)),
    ]);
  }

  (async () => {
    let session;
    try {
      ({ data: { session } } = await withTimeout(supabase.auth.getSession(), 10000, 'sesión'));
    } catch (err) {
      console.error('[aula] no se pudo verificar la sesión:', err);
      window.location.replace('/entrar/'); return;
    }
    if (!session) { window.location.replace('/entrar/'); return; }

    const { data: profile } = await supabase
      .from('profiles').select('full_name, email, role').eq('id', session.user.id).single();
    $('greeting').textContent = T.greeting;

    // Solo Emi (admin) ve el enlace de regreso al panel. Los miembros no tienen
    // panel ni "cuenta": entran directo al aula y solo pueden salir.
    const isAdmin = !!(profile && profile.role === 'admin');
    if (isAdmin && $('adminBack')) $('adminBack').hidden = false;

    // Estado de suscripción (Stripe → tabla `subscriptions`).
    let sub = await loadSub();
    let hasActive = isActiveSub(sub);

    // Pregunta a Stripe directamente (por el correo del miembro) si ya pagó y
    // espeja la fila que falte. Es la red de seguridad contra el "bucle de pago":
    // si el webhook no llegó/falló/tardó, el miembro que YA pagó no queda
    // encerrado en la puerta de pago. Falla en silencio (devuelve false).
    async function reconcileWithStripe() {
      try {
        const { data: { session: s } } = await supabase.auth.getSession();
        const res = await fetch('/api/verify-subscription', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + (s && s.access_token || '') },
        });
        const out = await res.json();
        return !!(out && out.active);
      } catch (_) { return false; }
    }

    // Solo tiene sentido para un miembro (no admin) sin suscripción activa a la vista.
    const search = new URLSearchParams(window.location.search);
    const justPaid = search.get('pago') === 'ok';
    if (!hasActive && !isAdmin) {
      // Si viene de pagar (?pago=ok), el webhook puede tardar 1-3 s: dale un par
      // de reintentos de lectura antes de molestar a Stripe.
      if (justPaid) {
        for (let i = 0; i < 3 && !hasActive; i++) {
          await new Promise((r) => setTimeout(r, 2000));
          sub = await loadSub();
          hasActive = isActiveSub(sub);
        }
      }
      // Red de seguridad definitiva: confirma con Stripe y vuelve a leer. Cubre
      // también al que llega por el enlace mágico del correo (sin ?pago=ok).
      if (!hasActive && await reconcileWithStripe()) {
        sub = await loadSub();
        hasActive = isActiveSub(sub);
      }
    }
    if (justPaid) history.replaceState(null, '', window.location.pathname);

    // Miembros con suscripción activa ven el enlace al portal de Stripe (gestionar
    // tarjeta / baja). Emi (admin) no lo necesita.
    const billing = $('acctBilling');
    if (billing && hasActive && !isAdmin) {
      billing.hidden = false;
      billing.addEventListener('click', async (e) => {
        e.preventDefault();
        try {
          const { data: { session: s } } = await supabase.auth.getSession();
          const res = await fetch('/api/portal', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + (s && s.access_token || '') },
            body: JSON.stringify({ lang: pageLang }),
          });
          const out = await res.json();
          if (out.url) window.location.href = out.url;
          else alert(out.error || (EN ? 'Could not open the billing portal.' : 'No se pudo abrir el portal.'));
        } catch (_) {
          alert(EN ? 'Could not open the billing portal.' : 'No se pudo abrir el portal.');
        }
      });
    }

    // Concepto Base y Bonus Material son independientes del ejercicio semanal
    // (pestañas propias, sin bloquearse entre sí): se cargan en paralelo, sin
    // esperar a que resuelva el bloque de abajo.
    loadBaseConcept();
    loadBonusMaterial();

    // Ejercicio vigente (uno solo, global, kind='semana'). La RLS de miembro ya
    // solo deja ver el que está en ventana; aun así filtramos por vigencia para
    // que el admin (que ve TODOS por su política) también vea aquí el que está
    // en vivo, no uno programado — y por kind, para no mezclar con Concepto
    // Base/Bonus, que ahora viven en la misma tabla.
    const nowISO = new Date().toISOString();
    const { data: rows, error } = await supabase
      .from('exercises').select('*')
      .eq('kind', 'semana')
      .lte('publish_at', nowISO)
      .gt('unpublish_at', nowISO)
      .order('publish_at', { ascending: false })
      .limit(1);
    if (error) console.error('[aula] exercises error:', error);
    const ex = rows && rows[0];
    console.log('[aula] perfil:', profile, '· ejercicio:', ex);
    // Tour de bienvenida (punto 12): la primera vez que un miembro con acceso
    // entra al aula. No se muestra en la puerta de pago (sin pestañas que
    // presentar). El propio tour respeta el flag de localStorage con auto:true.
    function maybeAutoTour() {
      if (typeof window.startAulaTour === 'function') window.startAulaTour({ auto: true });
    }

    if (!ex) {
      // Sin ejercicio: si es un miembro sin suscripción, ofrécele suscribirse;
      // si tiene suscripción (o es admin) es que no hay ejercicio en ventana ahora.
      if (!isAdmin && !hasActive) showSubscribeGate();
      else { showLocked(); maybeAutoTour(); }
      return;
    }

    // Título, semana, descripción
    $('exTitle').textContent = EN ? ex.title_en : ex.title_es;
    if ($('exMeta')) $('exMeta').textContent = ex.week_label || '';
    const desc = (EN ? ex.desc_en : ex.desc_es) || '';
    const descEl = $('exDesc');
    if (descEl) {
      descEl.innerHTML = '';
      desc.split(/\n\s*\n|\n/).filter((p) => p.trim()).forEach((p) => {
        const el = document.createElement('p'); el.textContent = p.trim(); descEl.appendChild(el);
      });
    }

    // Video con selector ES/EN
    const renderVideo = (which) => embedPlayer($('player'), which === 'en' ? ex.vimeo_url_en : ex.vimeo_url_es);
    renderVideo(pageLang);
    document.querySelectorAll('#panel-semana .vtab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('#panel-semana .vtab').forEach((x) => x.setAttribute('aria-selected', x === tab ? 'true' : 'false'));
        renderVideo(tab.dataset.vlang);
      });
    });

    wirePdfButton($('pdfBtn'), EN ? ex.pdf_path_en : ex.pdf_path_es);

    // ----- FORO real (questions + answers de Emi) -----
    const threadEl = $('thread');
    const composeForm = $('composeForm');
    const composeText = $('composeText');
    const myName = displayName(profile);

    function messageLi(text) {
      const li = document.createElement('li');
      li.className = 'q'; li.setAttribute('data-empty', '');
      const p = document.createElement('p'); p.className = 'q__body'; p.style.color = 'var(--color-text-soft)';
      p.textContent = text; li.appendChild(p);
      return li;
    }

    function renderQuestion(q) {
      const li = document.createElement('li'); li.className = 'q';
      const top = document.createElement('div'); top.className = 'q__top';
      const ava = document.createElement('span'); ava.className = 'ava'; ava.setAttribute('aria-hidden', 'true');
      ava.textContent = avatarLetter(q.author_name);
      const who = document.createElement('div');
      const whoName = document.createElement('div'); whoName.className = 'q__who';
      const mine = q.user_id === session.user.id;
      whoName.textContent = (q.author_name || '') + (mine ? ` (${T.you})` : '');
      const when = document.createElement('div'); when.className = 'q__when'; when.textContent = timeAgo(q.created_at);
      who.appendChild(whoName); who.appendChild(when);
      top.appendChild(ava); top.appendChild(who);
      const body = document.createElement('p'); body.className = 'q__body'; body.textContent = q.body;
      li.appendChild(top); li.appendChild(body);

      const ans = q.answers && q.answers[0];
      if (ans) {
        const a = document.createElement('div'); a.className = 'answer';
        const atop = document.createElement('div'); atop.className = 'q__top';
        const aava = document.createElement('span'); aava.className = 'ava'; aava.setAttribute('aria-hidden', 'true'); aava.textContent = 'E';
        const ad = document.createElement('div');
        const an = document.createElement('div'); an.className = 'q__who'; an.textContent = 'Emilse Rios';
        const ar = document.createElement('div'); ar.className = 'q__role'; ar.textContent = T.answerRole;
        ad.appendChild(an); ad.appendChild(ar);
        atop.appendChild(aava); atop.appendChild(ad);
        const ab = document.createElement('p'); ab.className = 'q__body'; ab.textContent = ans.body;
        a.appendChild(atop); a.appendChild(ab);
        li.appendChild(a);
      } else {
        const p = document.createElement('div'); p.className = 'answer answer--pending';
        const pa = document.createElement('span'); pa.className = 'ava'; pa.setAttribute('aria-hidden', 'true'); pa.textContent = 'E';
        const ps = document.createElement('span'); ps.textContent = T.pending;
        p.appendChild(pa); p.appendChild(ps);
        li.appendChild(p);
      }
      return li;
    }

    async function loadForum() {
      // La RLS filtra por ventana + suscripción; el idioma lo filtramos aquí.
      const { data, error } = await supabase
        .from('questions')
        .select('id, user_id, body, author_name, created_at, answers(id, body, created_at)')
        .eq('exercise_id', ex.id)
        .eq('lang', pageLang)
        .order('created_at', { ascending: false })
        .order('created_at', { ascending: true, foreignTable: 'answers' });
      if (error) { console.error('[aula] forum error:', error); threadEl.replaceChildren(messageLi(T.forumError)); return; }
      if (!data || !data.length) { threadEl.replaceChildren(messageLi(T.emptyForum)); return; }
      threadEl.replaceChildren(...data.map(renderQuestion));
    }
    await loadForum();

    if (composeForm) composeForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const txt = (composeText.value || '').trim();
      if (!txt) return;
      const btn = composeForm.querySelector('button[type="submit"]');
      const label = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = T.sending; }
      const { data: inserted, error } = await supabase
        .from('questions')
        .insert({ exercise_id: ex.id, user_id: session.user.id, lang: pageLang, body: txt, author_name: myName })
        .select('id, user_id, body, author_name, created_at, answers(id, body, created_at)')
        .single();
      if (btn) { btn.disabled = false; btn.textContent = label; }
      if (error) { console.error('[aula] post error:', error); alert(T.postError); return; }
      const empty = threadEl.querySelector('[data-empty]'); if (empty) empty.remove();
      const node = renderQuestion(inserted);
      threadEl.insertBefore(node, threadEl.firstChild);
      composeText.value = '';
      node.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    // El aula ya está lista (ejercicio + foro): ofrece el tour la primera vez.
    maybeAutoTour();
  })();
</script>
<script is:inline>
  // Menú de cuenta (engranaje): soporte / darse de baja. UI pura, sin datos.
  (function () {
    var btn = document.getElementById('gearBtn');
    var menu = document.getElementById('gearMenu');
    if (!btn || !menu) return;
    function close() { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
    function open() { menu.hidden = false; btn.setAttribute('aria-expanded', 'true'); }
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      if (menu.hidden) open(); else close();
    });
    document.addEventListener('click', function (e) {
      if (!menu.hidden && !menu.contains(e.target) && e.target !== btn) close();
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  })();
</script>
<script is:inline>
  /* Tour de bienvenida (onboarding paso a paso, estilo Figma). Se dispara la
     primera vez (guardado en localStorage) y se puede repetir desde el menú del
     engranaje ("Ver tutorial"). Todo el copy está en la voz de Emi (ES/EN). */
  (function () {
    var EN = document.body.dataset.pageLang === 'en';
    var STORE_KEY = 'erm_tour_v1';

    // Paso: { sel, tab, scroll, top, text }. sel=null → cuadro centrado, sin foco.
    var steps = EN ? [
      { sel: null, text: 'Welcome to your classroom! Let me walk you through everything you have on hand to study, step by step.' },
      { sel: '#tab-semana', tab: 'semana', top: true, text: 'Here’s your exercise of the week: the video, its description and —when the exercise includes one— a button to download the PDF and keep it on your stand.' },
      { sel: '#composeForm', tab: 'semana', scroll: true, text: 'Right below the exercise you’ll find questions and answers. Leave me any doubt that comes up and I’ll reply to you personally, no rush.' },
      { sel: '#tab-base', tab: 'base', top: true, text: 'This is the Core Concept: the video that all of the month’s exercises are built on. It stays available all month, so come back to it whenever you need to.' },
      { sel: '#tab-bonus', tab: 'bonus', top: true, text: 'Here I’ll be adding Bonus Material little by little. It stays available always, for you to use as support or a complement whenever you like.' },
      { sel: '#gearBtn', top: true, text: 'And from this gear you can write to me if something on the platform isn’t working, or cancel your membership if you ever need to.' },
    ] : [
      { sel: null, text: '¡Bienvenido a tu aula! Deja que te muestre, paso a paso, todo lo que tienes a mano para estudiar.' },
      { sel: '#tab-semana', tab: 'semana', top: true, text: 'Acá está tu ejercicio de la semana: el video, su descripción y —cuando el ejercicio lo traiga— un botón para descargar el PDF y tenerlo en el atril.' },
      { sel: '#composeForm', tab: 'semana', scroll: true, text: 'Justo debajo del ejercicio tienes las preguntas y respuestas. Déjame cualquier duda que te surja y yo te respondo personalmente, sin apuro.' },
      { sel: '#tab-base', tab: 'base', top: true, text: 'Este es el Concepto Base: el video que sostiene todos los ejercicios del mes. Está disponible durante todo el mes, así que vuelve a él siempre que lo necesites.' },
      { sel: '#tab-bonus', tab: 'bonus', top: true, text: 'Acá voy sumando Bonus Material poco a poco. Queda disponible siempre, para que lo uses como apoyo o complemento cuando quieras.' },
      { sel: '#gearBtn', top: true, text: 'Y desde este engranaje puedes escribirme si algo de la plataforma no te funciona, o darte de baja si alguna vez lo necesitas.' },
    ];
    var TOTAL = steps.length;
    var L = {
      count: function (n) { return EN ? (n + ' of ' + TOTAL) : (n + ' de ' + TOTAL); },
      next: EN ? 'Next' : 'Siguiente',
      done: EN ? 'Done' : 'Listo',
      skip: EN ? 'Skip' : 'Saltar',
    };

    var root, block, spot, pop, popCount, popText, popSkip, popBtn;
    var i = 0, active = false;

    function build() {
      root = document.createElement('div'); root.className = 'tour'; root.hidden = true;
      block = document.createElement('div'); block.className = 'tour__block';
      spot = document.createElement('div'); spot.className = 'tour__spot'; spot.hidden = true;
      pop = document.createElement('div'); pop.className = 'tour__pop'; pop.setAttribute('role', 'dialog'); pop.setAttribute('aria-modal', 'true');
      popCount = document.createElement('div'); popCount.className = 'tour__count';
      popText = document.createElement('p'); popText.className = 'tour__text';
      var actions = document.createElement('div'); actions.className = 'tour__actions';
      popSkip = document.createElement('button'); popSkip.type = 'button'; popSkip.className = 'tour__skip'; popSkip.textContent = L.skip;
      popBtn = document.createElement('button'); popBtn.type = 'button'; popBtn.className = 'tour__btn';
      actions.append(popSkip, popBtn);
      pop.append(popCount, popText, actions);
      root.append(block, spot, pop);
      document.body.appendChild(root);

      popBtn.addEventListener('click', function () { if (i >= TOTAL - 1) finish(true); else goTo(i + 1); });
      popSkip.addEventListener('click', function () { finish(true); });
      document.addEventListener('keydown', onKey);
      // El recorte y el cuadro son fixed: si la página se mueve, los realineamos
      // con la sección de turno (no congelamos el scroll para poder desplazarnos
      // hasta el foro en el paso 3).
      window.addEventListener('resize', reposition);
      window.addEventListener('scroll', reposition, { passive: true });
    }

    function onKey(e) {
      if (!active) return;
      if (e.key === 'Escape') { finish(true); }
      else if (e.key === 'Enter' || e.key === 'ArrowRight') { e.preventDefault(); popBtn.click(); }
    }

    function activateTab(name) {
      var btn = document.getElementById('tab-' + name);
      if (btn && btn.getAttribute('aria-selected') !== 'true') btn.click();
    }

    function visibleRect(el) {
      if (!el) return null;
      var r = el.getBoundingClientRect();
      if (r.width < 2 || r.height < 2) return null;
      return r;
    }

    function place() {
      var step = steps[i];
      var el = step.sel ? document.querySelector(step.sel) : null;
      var r = visibleRect(el);
      if (!r) {
        // Centrado (paso de bienvenida o elemento no visible en este estado).
        spot.hidden = true; spot.classList.remove('is-glow');
        block.classList.add('is-full');
        pop.style.top = '50%'; pop.style.left = '50%'; pop.style.transform = 'translate(-50%, -50%)';
        return;
      }
      block.classList.remove('is-full');
      var pad = 8;
      spot.hidden = false;
      spot.style.top = (r.top - pad) + 'px';
      spot.style.left = (r.left - pad) + 'px';
      spot.style.width = (r.width + pad * 2) + 'px';
      spot.style.height = (r.height + pad * 2) + 'px';
      spot.classList.add('is-glow');
      pop.style.transform = 'none';
      var pw = pop.offsetWidth, ph = pop.offsetHeight, m = 16;
      var top = r.bottom + 14;
      if (top + ph > window.innerHeight - m) { var above = r.top - ph - 14; top = above >= m ? above : Math.max(m, window.innerHeight - ph - m); }
      var left = r.left + r.width / 2 - pw / 2;
      left = Math.max(m, Math.min(left, window.innerWidth - pw - m));
      pop.style.top = top + 'px'; pop.style.left = left + 'px';
    }

    function reposition() { if (active) place(); }

    function goTo(n) {
      i = n;
      var step = steps[i];
      popCount.textContent = L.count(i + 1);
      popText.textContent = step.text;
      popBtn.textContent = (i >= TOTAL - 1) ? L.done : L.next;
      if (step.tab) activateTab(step.tab);
      if (step.top) window.scrollTo({ top: 0, behavior: 'auto' });
      requestAnimationFrame(function () {
        if (step.scroll && step.sel) { var el = document.querySelector(step.sel); if (el) el.scrollIntoView({ block: 'center', behavior: 'auto' }); }
        requestAnimationFrame(place);
      });
    }

    function finish(markDone) {
      active = false;
      if (root) root.hidden = true;
      // Vuelve a la pestaña inicial para que el aula quede como estaba.
      activateTab('semana');
      window.scrollTo({ top: 0, behavior: 'auto' });
      if (markDone) { try { localStorage.setItem(STORE_KEY, '1'); } catch (_) {} }
    }

    function start() {
      if (!root) build();
      active = true;
      root.hidden = false;
      goTo(0);
    }

    // API pública: el módulo de datos la llama tras cargar el aula (auto:true) y
    // el menú del engranaje la usa para repetir el tour.
    window.startAulaTour = function (opts) {
      opts = opts || {};
      if (opts.auto) { try { if (localStorage.getItem(STORE_KEY)) return; } catch (_) {} }
      start();
    };

    var replay = document.getElementById('tourReplay');
    if (replay) replay.addEventListener('click', function () {
      var menu = document.getElementById('gearMenu'), btn = document.getElementById('gearBtn');
      if (menu) menu.hidden = true; if (btn) btn.setAttribute('aria-expanded', 'false');
      window.startAulaTour({ auto: false });
    });
  })();
</script>
<script src="/membresia-ui.js" defer></script>
</body>
</html>
